{
  // Requires a secret: `wrangler secret put BIRDEYE_API_KEY`
  // (for `wrangler dev`, put BIRDEYE_API_KEY=... in tradesight/.dev.vars)
  "name": "tradesight",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }
}
